# Backend Environment Variables
# Used by Node.js/Express

# URL do Serviço de IA (FastAPI)
# Em produção, será a URL do seu serviço de IA no Render
AI_SERVICE_URL=http://localhost:8001/analyze_vitals

# URL de Conexão com o Banco de Dados PostgreSQL
# Em produção, será a URL fornecida pelo seu provedor de DB (ex: Render, Supabase)
DATABASE_URL=postgres://user:password@host:port/database_name

# Porta que o Backend irá escutar
PORT=3001
